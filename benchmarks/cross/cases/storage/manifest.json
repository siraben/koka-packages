{
  "cases": [
    {
      "id": "storage-sqlite-bound-insert",
      "title": "SQLite in-memory bound insert in one prepared transaction",
      "package": "sqlite",
      "chart_label": "SQLite bound inserts",
      "unit": "rows",
      "default_work": 100000,
      "equivalence": "Create the same in-memory table, explicitly begin one transaction, insert {work} rows through one prepared statement with bound integer i and text 'row-i', commit, then print exactly: rows=N sum_i=S text_bytes=B. N must equal work, S is sum(i), and B is sum of UTF-8 text lengths.",
      "implementations": [
        {
          "id": "storage-sqlite-koka",
          "language": "Koka",
          "version_command": ["../../../../../kk", "--version"],
          "build": ["bash", "build_sqlite_koka.sh"],
          "run": ["build/sqlite_koka", "{work}"]
        },
        {
          "id": "storage-sqlite-python",
          "language": "Python",
          "version_command": ["python3", "-c", "import sqlite3,sys; print(sys.version.split()[0], sqlite3.sqlite_version)"],
          "run": ["python3", "sqlite_python.py", "{work}"]
        }
      ]
    },
    {

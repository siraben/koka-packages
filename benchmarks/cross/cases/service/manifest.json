      "package": "json",
      "chart_label": "JSON generation",
      "unit": "documents",
      "default_work": 1000,
      "equivalence": "Each implementation constructs [0,...,1999] once, then uses its language's JSON library to serialize that value once per repetition in compact form. The checksum is the sum of encoded lengths.",
